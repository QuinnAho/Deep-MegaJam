# Unreal Engine: generated folders (the project lives in deep/)
deep/Binaries/
deep/DerivedDataCache/
deep/Intermediate/
deep/Saved/
deep/Plugins/**/Binaries/
deep/Plugins/**/Intermediate/

# IDE and solution files (regenerated from the .uproject)
deep/.vs/
deep/.idea/
deep/*.sln
deep/*.slnx
deep/*.VC.db
deep/*.VC.opendb
deep/*.suo
deep/*.xcworkspace

# Packaged builds
Builds/
*.zip

# Claude Code: per-machine files
.claude/settings.local.json
.claude/worktrees/
.wt/

# Obsidian: per-user window layout
deep-claude-brain/.obsidian/workspace.json
deep-claude-brain/.obsidian/workspace-mobile.json

# Secrets
.env
.env.*
*.key

# Third-party packs stay outside git (D-033). Each pack sits in its own folder under deep/Content,
# where Fab or a migrate puts it, and is linked into the agents' worktrees. One line per pack.
# No trailing slash: a worktree holds a link of this name, not a folder.
deep/Content/Packs/
deep/Content/DragonCave

# Written by packaging (the order files were opened in); rebuilt on every package
deep/Build/Windows/FileOpenOrder/
# Sound files from Quinn's brother, waiting to be imported (D-040). The imported assets go in deep/Content/DeepAudio.
audio-drop/

# Free models Quinn downloads (D-049; the vault note Polish - Sub Assets), waiting to be imported. Never committed.
asset-drop/
